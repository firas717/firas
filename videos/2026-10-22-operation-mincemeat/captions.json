[
 {
  "start": 0.0,
  "end": 2.34,
  "text": "في عام 1943"
 },
 {
  "start": 2.34,
  "end": 3.74,
  "text": "وجد صياد إسباني"
 },
 {
  "start": 3.74,
  "end": 6.26,
  "text": "جثة ضابط بريطاني تطفو قرب الشاطئ."
 },
 {
  "start": 6.26,
  "end": 7.8,
  "text": "كان يرتدي الزي العسكري"
 },
 {
  "start": 7.8,
  "end": 9.46,
  "text": "ويحمل صورة لخطيبته"
 },
 {
  "start": 9.46,
  "end": 11.46,
  "text": "ورسائل الحب، وفواتير قديمة…"
 },
 {
  "start": 11.46,
  "end": 13.3,
  "text": "وكل شيء يدل بأن الضابط"
 },
 {
  "start": 13.3,
  "end": 15.52,
  "text": "مات بعد سقوط طائرته في البحر."
 },
 {
  "start": 15.52,
  "end": 16.86,
  "text": "لكن أكثر شيء لفت"
 },
 {
  "start": 16.86,
  "end": 19.36,
  "text": "انتباه السلطات لم يكن الجثة نفسها."
 },
 {
  "start": 19.36,
  "end": 21.72,
  "text": "بل كانت حقيبة صغيرة مربوطة بيده."
 },
 {
  "start": 21.72,
  "end": 23.54,
  "text": "وداخل الحقيبة، كانت هناك"
 },
 {
  "start": 23.54,
  "end": 25.68,
  "text": "وثائق عسكرية شديدة السرية."
 },
 {
  "start": 25.68,
  "end": 26.84,
  "text": "وثائق تكشف"
 },
 {
  "start": 26.84,
  "end": 29.94,
  "text": "مكان الهجوم القادم لقوات الحلفاء ضد ألمانيا."
 },
 {
  "start": 30.0,
  "end": 31.4,
  "text": "لو كانت هذه الأوراق"
 },
 {
  "start": 31.4,
  "end": 33.8,
  "text": "حقيقية فهي قد تغيّر مسار الحرب."
 },
 {
  "start": 33.8,
  "end": 35.06,
  "text": "لكن هنا المفاجأة"
 },
 {
  "start": 35.06,
  "end": 37.34,
  "text": "الضابط الميت لم يكن موجوداً أصلاً."
 },
 {
  "start": 37.34,
  "end": 39.98,
  "text": "لا اسمه حقيقي، ولا خطيبته حقيقية."
 },
 {
  "start": 39.98,
  "end": 41.82,
  "text": "كل شيء كان عبارة عن خدعة."
 },
 {
  "start": 41.82,
  "end": 44.14,
  "text": "حتى الرجل الميت لم يكن ضابطاً."
 },
 {
  "start": 44.14,
  "end": 45.98,
  "text": "بريطانيا كانت تخطط"
 },
 {
  "start": 45.98,
  "end": 47.46,
  "text": "لغزو جزيرة صقلية"
 },
 {
  "start": 47.46,
  "end": 50.04,
  "text": "وكانت تعرف أن الألمان ينتظرون الهجوم."
 },
 {
  "start": 50.04,
  "end": 52.66,
  "text": "ولو أرسل هتلر قواته إلى صقلية"
 },
 {
  "start": 52.66,
  "end": 54.82,
  "text": "فالعملية قد تتحول إلى كارثة."
 },
 {
  "start": 54.82,
  "end": 56.94,
  "text": "لهذا، احتاج البريطانيون"
 },
 {
  "start": 56.94,
  "end": 59.34,
  "text": "إلى جعل الألمان يعتقدون أن الهدف"
 },
 {
  "start": 59.34,
  "end": 61.86,
  "text": "الحقيقي ليس صقلية، بل اليونان."
 },
 {
  "start": 61.86,
  "end": 63.5,
  "text": "وهنا بدأت الخطة الغريبة."
 },
 {
  "start": 63.5,
  "end": 65.42,
  "text": "أخذوا جثة رجل مجهول"
 },
 {
  "start": 65.42,
  "end": 67.7,
  "text": "وصنعوا له حياة كاملة من الصفر."
 },
 {
  "start": 67.7,
  "end": 69.26,
  "text": "أعطوا جثة الرجل اسم"
 },
 {
  "start": 69.26,
  "end": 70.4,
  "text": "الرائد ويليام مارتن."
 },
 {
  "start": 70.4,
  "end": 72.5,
  "text": "ألبسوه زيّ ضابط بريطاني"
 },
 {
  "start": 72.5,
  "end": 74.66,
  "text": "ووضعوا في جيوبه صورة فتاة"
 },
 {
  "start": 74.66,
  "end": 77.0,
  "text": "ورسائل شخصية، وتذكرة مسرح"
 },
 {
  "start": 77.0,
  "end": 78.6,
  "text": "وفاتورة خاتم خطوبة."
 },
 {
  "start": 78.6,
  "end": 80.58,
  "text": "لدرجة إنهم وضعوا أشياء"
 },
 {
  "start": 80.58,
  "end": 83.02,
  "text": "صغيرة لا ينتبه لها أحد عادةً"
 },
 {
  "start": 83.02,
  "end": 85.48,
  "text": "لأنهم كانوا يعلمون بأن التفاصيل"
 },
 {
  "start": 85.48,
  "end": 87.62,
  "text": "هي التي تجعل الكذبة تبدو حقيقية."
 },
 {
  "start": 87.62,
  "end": 89.8,
  "text": "ثم وضعوا معه الوثائق المزيفة"
 },
 {
  "start": 89.8,
  "end": 92.12,
  "text": "وأرسلوا الجثة قرب سواحل إسبانيا."
 },
 {
  "start": 92.12,
  "end": 95.3,
  "text": "وكانوا يعلمون بأن إسبانيا محايدة على الورق…"
 },
 {
  "start": 95.3,
  "end": 98.04,
  "text": "لكن فيها رجال ينقلون المعلومات للألمان."
 },
 {
  "start": 98.04,
  "end": 101.1,
  "text": "الخطة كانت كلها معلقة على سؤال واحد"
 },
 {
  "start": 101.1,
  "end": 103.76,
  "text": "هل ستصل الأوراق إلى الألمان؟"
 },
 {
  "start": 103.76,
  "end": 105.68,
  "text": "وهل سيقرؤونها ويصدقونها؟"
 },
 {
  "start": 105.68,
  "end": 108.38,
  "text": "عثر الإسبان على الجثة، وأخذوا الحقيبة."
 },
 {
  "start": 108.38,
  "end": 109.44,
  "text": "وفي بريطانيا"
 },
 {
  "start": 109.44,
  "end": 112.24,
  "text": "بدأ فريق العملية يمثل دوره الأخير"
 },
 {
  "start": 112.24,
  "end": 112.92,
  "text": "القلق."
 },
 {
  "start": 112.92,
  "end": 115.92,
  "text": "أرسلوا طلبات عاجلة لاستعادة الحقيبة"
 },
 {
  "start": 115.92,
  "end": 117.7,
  "text": "وكأنهم خائفون فعلاً"
 },
 {
  "start": 117.7,
  "end": 119.98,
  "text": "من أن تقع أسرارهم في الأيدي الخطأ."
 },
 {
  "start": 119.98,
  "end": 121.74,
  "text": "ثم عاد كل شيء إليهم"
 },
 {
  "start": 121.74,
  "end": 124.08,
  "text": "الجثة، الحقيبة، والأوراق."
 },
 {
  "start": 124.08,
  "end": 126.82,
  "text": "كانت الحقيبة تبدو كأنها لم تُفتح."
 },
 {
  "start": 126.82,
  "end": 128.28,
  "text": "لكن بعد فترة"
 },
 {
  "start": 128.28,
  "end": 130.72,
  "text": "وصلت الإشارة التي كانوا ينتظرونها"
 },
 {
  "start": 130.72,
  "end": 132.96,
  "text": "الألمان اطّلعوا على الوثائق."
 },
 {
  "start": 132.96,
  "end": 134.16,
  "text": "ولم يشكوا فيها."
 },
 {
  "start": 134.16,
  "end": 135.94,
  "text": "وبدأ الألمان يعززون"
 },
 {
  "start": 135.94,
  "end": 138.02,
  "text": "دفاعاتهم في اليونان وسردينيا."
 },
 {
  "start": 138.02,
  "end": 140.88,
  "text": "وفي الوقت الذي كانوا يحرسون فيه المكان الخطأ…"
 },
 {
  "start": 140.88,
  "end": 143.7,
  "text": "كانت قوات الحلفاء تتجه إلى صقلية."
 },
 {
  "start": 143.7,
  "end": 145.56,
  "text": "في يوليو 1943"
 },
 {
  "start": 145.56,
  "end": 147.72,
  "text": "بدأ الغزو الحقيقي."
 },
 {
  "start": 147.72,
  "end": 150.92,
  "text": "والرجل الذي لم يعش يوماً باسم ويليام مارتن"
 },
 {
  "start": 150.92,
  "end": 154.06,
  "text": "نجح في مهمة لم ينجح فيها أي جاسوس حي."
 },
 {
  "start": 154.06,
  "end": 156.66,
  "text": "خدع جيشاً كاملاً، لأن العدو"
 },
 {
  "start": 156.66,
  "end": 158.84,
  "text": "لم يجد كذبة مكتوبة على ورقة…"
 },
 {
  "start": 158.84,
  "end": 160.26,
  "text": "وجد قصة كاملة"
 },
 {
  "start": 160.26,
  "end": 162.64,
  "text": "تبدو حقيقية أكثر من اللازم."
 }
]